                 purpose: #STANDARD,
                 type: #FIELDGROUP_REFERENCE,
                 position: 20,
                 parentId: 'emp_data',
                 targetQualifier: 'admindata' } ]
  @UI.fieldGroup: [ { qualifier: 'personal_data', position: 10 } ]
  @UI.lineItem: [ { label: 'Id', position: 10 },
                  { type: #FOR_ACTION, label: 'Copy instance', dataAction: 'copy_instance' },
                  { type: #FOR_ACTION, label: 'New instance', dataAction: 'new_instance' } ]
  @UI.selectionField: [ { position: 10 } ]
  Id;

  @EndUserText.label: 'First name'
