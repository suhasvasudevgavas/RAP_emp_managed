  @UI.fieldGroup: [ { qualifier: 'personal_data', position: 30 } ]
  @UI.lineItem: [ { label: 'Lname', position: 30 } ]
  Lname;

  @EndUserText.label: 'Date of birth'
  @UI.fieldGroup: [ { qualifier: 'personal_data', position: 40 } ]
  @UI.lineItem: [ { label: 'Dob', position: 40 } ]
  Dob;

