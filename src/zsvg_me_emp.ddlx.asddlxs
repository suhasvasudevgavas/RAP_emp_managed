  @UI.fieldGroup: [ { qualifier: 'personal_data', position: 50 } ]
  @UI.lineItem: [ { label: 'Age', position: 45 } ]
  Age;

  @Consumption.valueHelpDefinition: [ { entity: { name: 'zsvg_i_loc', element: 'value_low' },
