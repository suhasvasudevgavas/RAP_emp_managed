  @UI.fieldGroup: [ { qualifier: 'personal_data', position: 20 } ]
  @UI.lineItem: [ { label: 'Fname', position: 20 } ]
  @UI.selectionField: [ { position: 20 } ]
  Fname;

  @EndUserText.label: 'Last name'
  @Search.defaultSearchElement: true
