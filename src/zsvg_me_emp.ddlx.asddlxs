@Metadata.layer: #CORE

@Search.searchable: true

@UI.headerInfo: { typeName: 'Employee',
                  typeNamePlural: 'Employees',
                  title: { label: 'Employee', type: #STANDARD, value: 'Lname' } }

annotate entity zsvg_c_emp with

{
  @EndUserText.label: 'ID'
  @UI.facet: [ { label: 'Employee data', id: 'emp_data', type: #COLLECTION, position: 10 },
               { id: 'proj',
                 label: 'Project',
                 position: 20,
                 purpose: #STANDARD,
                 type: #LINEITEM_REFERENCE,
                 targetElement: '_proj',
                 parentId: 'emp_data' },
               { label: 'Peronal data',
                 purpose: #STANDARD,
                 type: #FIELDGROUP_REFERENCE,
                 position: 10,
                 parentId: 'emp_data',
                 targetQualifier: 'personal_data' },
