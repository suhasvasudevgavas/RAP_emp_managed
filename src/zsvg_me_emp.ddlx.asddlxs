  @UI.fieldGroup: [ { qualifier: 'personal_data', position: 80 } ]
  @UI.lineItem: [ { label: 'State', position: 55 } ]
  State;

  @EndUserText.label: 'Description'
  @UI.fieldGroup: [ { qualifier: 'personal_data', position: 90 } ]
  @UI.lineItem: [ { label: 'State_text', position: 57 } ]
  State_text;

  @EndUserText.label: 'Created by'
  @UI.fieldGroup: [ { qualifier: 'admindata', position: 10 } ]
  @UI.lineItem: [ { label: 'CreatedBy', position: 60 } ]
  CreatedBy;

