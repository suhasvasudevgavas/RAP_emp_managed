@Metadata.layer: #CORE

@UI.headerInfo: { typeName: 'Project',
                  typeNamePlural: 'Projects',
                  title: { label: 'Project', type: #STANDARD, value: 'Name' } }

annotate entity zsvg_c_proj with

{
  @UI.facet: [ { label: 'Project data',
                 type: #COLLECTION,
                 id : 'proj_data',
                 position: 10
                  },
               { label: 'Project info',
                 purpose: #STANDARD,
                 type: #FIELDGROUP_REFERENCE,
                 position: 10,
                 parentId: 'proj_data',
                 targetQualifier: 'proj_info' },
               { label: 'Admin data',
                 purpose: #STANDARD,
                 type: #FIELDGROUP_REFERENCE,
                 position: 20,
                 parentId: 'proj_data',
                 targetQualifier: 'admindata' }
  ]

  @EndUserText.label: 'Id'
  @UI.fieldGroup: [ { qualifier: 'proj_info', position: 10 } ]
  @UI.lineItem: [ { label: 'Id', position: 10 } ]
  Id;

  @EndUserText.label: 'Employee Id'
  @UI.fieldGroup: [ { qualifier: 'proj_info', position: 20 } ]
  @UI.lineItem: [ { label: 'EmpId', position: 20 } ]
  EmpId;

  @EndUserText.label: 'Project name'
  @UI.fieldGroup: [ { qualifier: 'proj_info', position: 30 } ]
  @UI.lineItem: [ { label: 'Name', position: 30 } ]
  Name;

  @EndUserText.label: 'Location'
  @UI.fieldGroup: [ { qualifier: 'proj_info', position: 40 } ]
  @UI.lineItem: [ { label: 'Loc', position: 40 } ]
  @Consumption.valueHelpDefinition: [{ entity:{ name: 'zsvg_i_loc', element: 'value_low' },
  additionalBinding: [{ element: 'location_text', localElement: 'Location_text' }] }]
  Loc;

  @EndUserText.label: 'Alloc'
  @UI.fieldGroup: [ { qualifier: 'proj_info', position: 50 } ]
  @UI.lineItem: [ { label: 'Alloc', position: 50 } ]
  Alloc;

  @EndUserText.label: 'Start date'
  @UI.fieldGroup: [ { qualifier: 'proj_info', position: 60 } ]
  @UI.lineItem: [ { label: 'StartDate', position: 60 } ]
  StartDate;

  @EndUserText.label: 'Active'
  @UI.fieldGroup: [ { qualifier: 'proj_info', position: 70 } ]
  @UI.lineItem: [ { label: 'Active', position: 70 } ]
  Active;

  @EndUserText.label: 'End date'
  @UI.fieldGroup: [ { qualifier: 'proj_info', position: 80 } ]
  @UI.lineItem: [ { label: 'EndDate', position: 80 },
                  { type: #FOR_ACTION, label: 'End project', dataAction: 'end_project' } ]
  EndDate;

  @EndUserText.label: 'Created by'
  @UI.fieldGroup: [ { qualifier: 'admindata', position: 10 } ]
  @UI.lineItem: [ { label: 'CreatedBy', position: 90 } ]
  CreatedBy;

  @EndUserText.label: 'Created at'
  @UI.fieldGroup: [ { qualifier: 'admindata', position: 20 } ]
  @UI.lineItem: [ { label: 'CreatedAt', position: 100 } ]
  CreatedAt;

  @EndUserText.label: 'Last changed by'
  @UI.fieldGroup: [ { qualifier: 'admindata', position: 30 } ]
  @UI.lineItem: [ { label: 'LastchangedBy', position: 110 } ]
  LastchangedBy;

  @EndUserText.label: 'Last changed at'
  @UI.fieldGroup: [ { qualifier: 'admindata', position: 40 } ]
  @UI.lineItem: [ { label: 'LastchangedAt', position: 120 } ]
  LastchangedAt;

  @EndUserText.label: 'Loc inst last changed at'
  @UI.fieldGroup: [ { qualifier: 'admindata', position: 50 } ]
  @UI.lineItem: [ { label: 'LocinstLastchangedAt', position: 130 } ]
  LocinstLastchangedAt;
}